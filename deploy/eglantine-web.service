[Unit]
Description=Eglantine download website
After=network.target

[Service]
Type=simple
User=apps
WorkingDirectory=/opt/apps/eglantine.jvrcruz.games
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/apps/eglantine.jvrcruz.games/.env
Environment=BIND=127.0.0.1
Environment=PORT=39402
ExecStart=/usr/bin/python3 /opt/apps/eglantine.jvrcruz.games/service/server.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
