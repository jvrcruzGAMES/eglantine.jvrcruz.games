PUBLIC_URL=https://eglantine.jvrcruz.games
PORT=39402
BIND=0.0.0.0
POLL_SECONDS=120
REBUILD_SECONDS=3600
RETRY_SECONDS=1800
BUILD_JOBS=6
# Optional override; default is min(10 GiB, 75% of Docker host RAM).
# BUILD_MEMORY=4g
# Use official prebuilt native Qt tools during first MinGW setup (source fallback on failure).
MXE_PREBUILT_HOST_QT=1
# Prefer validated official Windows MinGW Qt libraries; use 0 for source Qt only.
WINDOWS_PREBUILT_LIBS=1
